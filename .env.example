# Copy this file to .env and replace the placeholders.
# If your existing Postgres container was already initialized, keep the
# original POSTGRES_USER, POSTGRES_PASSWORD, and POSTGRES_DB values.
# Changing them later does not update an existing Docker volume.

POSTGRES_USER=admin
POSTGRES_PASSWORD=your-local-password
POSTGRES_DB=agency_db
DATABASE_URL=postgresql://admin:your-local-password@localhost:5432/agency_db
